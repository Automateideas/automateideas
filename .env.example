DATABASE_URL=postgres://app:devpassword@localhost:5432/hrms
REDIS_URL=redis://localhost:6379

# Random 32+ character string: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (console.cloud.google.com → Credentials). Optional.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sending (resend.com → API keys).
RESEND_API_KEY=
EMAIL_FROM="Automate Ideas <no-reply@example.com>"

PAYU_KEY=
PAYU_SALT=
# https://secure.payu.in/_payment in production
PAYU_BASE_URL=https://test.payu.in/_payment

# File storage: logos, signatures, stamps and PDF copies. Amazon S3, Cloudflare R2 or any S3-compatible server.
# Keep the bucket private ("Block all public access" on); the app serves files through short-lived signed links.
# Leave the keys empty to turn uploads off: everything else still works, files just aren't saved.
#
# Local development (docker compose up -d starts SeaweedFS on port 8333):
#   S3_BUCKET=automateideas-dev, S3_ENDPOINT=http://127.0.0.1:8333, and the access key + secret
#   from docker/seaweedfs/s3.json. Create the bucket once:
#   echo "s3.bucket.create -name=automateideas-dev" | docker compose exec -T s3 weed shell -master=localhost:9333
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Only for an S3-compatible server (local SeaweedFS, or R2: https://<account-id>.r2.cloudflarestorage.com); leave empty for Amazon S3.
S3_ENDPOINT=
